<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CollectorPackageIncludeCurrentTestPlatform>true</CollectorPackageIncludeCurrentTestPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heartbeat.Collection.Hub\Heartbeat.Collection.Hub.csproj" />
    <ProjectReference Include="..\..\collectors\Heartbeat.Collector.Reference.ManagedProcess\Heartbeat.Collector.Reference.ManagedProcess.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyManagedReferenceCollector" AfterTargets="Build">
    <ItemGroup>
      <ManagedReferenceCollectorFiles Include="..\..\collectors\Heartbeat.Collector.Reference.ManagedProcess\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ManagedReferenceCollectorFiles)"
          DestinationFiles="@(ManagedReferenceCollectorFiles->'$(OutDir)Fixtures/ManagedReferenceCollector/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/**/*" Exclude="Fixtures/ReferenceCollectorPackage/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="..\..\protocol\conformance\v1\collector-protocol-conformance.json">
      <Link>Conformance\collector-protocol-conformance.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StageReferenceCollectorFixture" BeforeTargets="Build">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\.."
          Command="node scripts/collector-contracts.mjs stage reference-fixture &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\CollectorPackage\ReferenceFixture'))&quot;" />
  </Target>
  <Target Name="CopyReferenceCollectorFixture" AfterTargets="Build" DependsOnTargets="StageReferenceCollectorFixture">
    <RemoveDir Directories="$(OutDir)Fixtures/ReferenceCollectorPackage" />
    <ItemGroup>
      <ReferenceCollectorFixtureFiles Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\CollectorPackage\ReferenceFixture'))/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReferenceCollectorFixtureFiles)"
          DestinationFiles="@(ReferenceCollectorFixtureFiles->'$(OutDir)Fixtures/ReferenceCollectorPackage/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
