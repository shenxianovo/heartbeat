{
  "manifestVersion": 1,
  "packageId": "heartbeat.collector.reference",
  "version": "1.0.0",
  "protocolMajors": [1],
  "supportedCapabilities": {
    "facts.segment": [1],
    "diagnostics.stream-gap": [1]
  },
  "config": { "version": 1, "accepts": [1] },
  "presentation": {
    "displayName": "Reference Collector",
    "summary": "A generic package used to prove host-independent Collector lifecycle behavior."
  },
  "defaultInstance": {
    "subjectKind": "machine",
    "configVersion": 1,
    "config": {}
  },
  "outputs": [
    {
      "outputId": "activity",
      "source": "reference",
      "factKind": "segment",
      "schema": {
        "id": "heartbeat.reference.segment",
        "major": 1,
        "revision": 1,
        "document": "schemas/reference-segment.schema.json"
      },
      "subjectKinds": ["machine"],
      "dimensionKeys": [
        "appIdentityKey",
        "externalHostIdentity"
      ]
    }
  ],
  "artifacts": [
    {
      "artifactId": "reference.inprocess",
      "selector": {
        "driver": "inProcess",
        "os": ["windows", "macos", "linux"],
        "arch": ["x64", "arm64"]
      },
      "entrypoint": "artifacts/reference-collector.artifact.json"
    }
  ]
}
